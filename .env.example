# ─────────────────────────────────────────────────────────────────────────────
# Bossi — משתני סביבה
#
# העתיקו ל-.env.local לפיתוח מקומי, והזינו ב-Vercel → Settings → Environment
# Variables לסביבות Preview ו-Production.
#
# הפירוט המלא — מה כל משתנה עושה, מאיפה משיגים אותו ובאיזה ספרינט הוא נדרש:
#   docs/09-environment.md
#
# סימון:  [1] נדרש עכשיו   ·   [S#] נדרש בספרינט מספר #   ·   [opt] אופציונלי
# ─────────────────────────────────────────────────────────────────────────────

# ── יסוד ─────────────────────────────────────────────────────────────────────
# NODE_ENV מנוהל אוטומטית ב-Vercel ואינו נדרש כאן.

# ── מסד נתונים · Postgres 16 + pgvector ─────────────────────────────────── S1
# Neon מומלץ: תואם Vercel, יש pgvector, ויש ענף נפרד לכל Preview.
DATABASE_URL=""                                       # [1] מחרוזת מאוגדת (pooled). **המשתנה היחיד שחובה.**
DATABASE_POOL_MAX="10"                                # [opt] גודל מאגר החיבורים

# ── אימות ────────────────────────────────────────────────────────────────── S2
# אין AUTH_SECRET: החיבורים אטומים ונשמרים במסד כ-SHA-256, לא כ-JWT חתום.
AUTH_STAFF_COOKIE="bossi_staff"                       # [S2] עולם הזהות של הצוות
AUTH_PORTAL_COOKIE="bossi_portal"                     # [S13] עולם הזהות של הלקוחות — נפרד לחלוטין

# ── אחסון קבצים · Cloudflare R2 (או S3) ─────────────────────────────────── S4
R2_ACCOUNT_ID=""                                      # [S4]
R2_ACCESS_KEY_ID=""                                   # [S4]
R2_SECRET_ACCESS_KEY=""                               # [S4]
R2_BUCKET="bossi-documents"                           # [S4] פרטי. לעולם לא ציבורי.
R2_REGION="auto"                                      # [S4]

# ── מייל יוצא · Resend ──────────────────────────────────────────────────── S5
RESEND_API_KEY=""                                     # [S5]
MAIL_FROM="Bossi <no-reply@bossi.co.il>"              # [S5]

# ── מייל נכנס · קליטת מסמכים ────────────────────────────────────────────── S5
# כל דייר מקבל כתובת docs+<slug>@<INBOUND_EMAIL_DOMAIN>.
INBOUND_EMAIL_DOMAIN="in.bossi.co.il"                 # [S5] דורש רשומת MX
INBOUND_WEBHOOK_SECRET=""                             # [S5] אימות חתימת ה-webhook

# ── OCR · לבחור אחרי בדיקת גל 0 על מסמכים בעברית ────────────────────────── S11
OCR_PROVIDER="google"                                 # [S11] google | azure
GOOGLE_APPLICATION_CREDENTIALS_JSON=""                # [S11] ה-JSON כולו בשורה אחת
GOOGLE_DOCAI_PROCESSOR_ID=""                          # [S11]
GOOGLE_DOCAI_LOCATION="eu"                            # [S11]
AZURE_DI_ENDPOINT=""                                  # [S11] חלופה ל-Google
AZURE_DI_KEY=""                                       # [S11]

# ── AI ──────────────────────────────────────────────────────────────────── S11
ANTHROPIC_API_KEY=""                                  # [S11] סיווג, חילוץ, סוכן חיפוש
EMBEDDINGS_PROVIDER="voyage"                          # [S11] לבדוק אמפירית מול עברית
VOYAGE_API_KEY=""                                     # [S11]

# ── הנפקת חשבוניות · לא מנפיקים בעצמנו ──────────────────────────────────── S7
INVOICING_PROVIDER="morning"                          # [S7] morning | rivhit | icount
MORNING_API_KEY=""                                    # [S7]
MORNING_API_SECRET=""                                 # [S7]

# ── סליקה · הלקוחות של בעל העסק משלמים לו ───────────────────────────────── S8
PAYMENTS_PROVIDER="cardcom"                           # [S8] cardcom | tranzila | payplus
CARDCOM_TERMINAL=""                                   # [S8]
CARDCOM_USERNAME=""                                   # [S8]
CARDCOM_API_KEY=""                                    # [S8]

# ── WhatsApp Business ───────────────────────────────────────────────────── S10
WHATSAPP_PROVIDER="360dialog"                         # [S10] 360dialog | twilio
WHATSAPP_API_KEY=""                                   # [S10]
WHATSAPP_PHONE_NUMBER_ID=""                           # [S10]
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""                      # [S10] תבניות טעונות אישור מראש

# ── מנויי Bossi · בעל העסק משלם לנו ─────────────────────────────────────── S12
# נפרד לגמרי מ-PAYMENTS_* — שני עולמות כספיים שלא נפגשים.
BILLING_PROVIDER="cardcom"                            # [S12]
BOSSI_BILLING_TERMINAL=""                             # [S12]
BOSSI_BILLING_API_KEY=""                              # [S12]

# ── משימות מתוזמנות · Vercel Cron ───────────────────────────────────────── S5
CRON_SECRET=""                                        # [S5] openssl rand -hex 32

# ── תצפית ───────────────────────────────────────────────────────────────── opt
SENTRY_DSN=""                                         # [opt]
NEXT_PUBLIC_SENTRY_DSN=""                             # [opt]

# ── סביבת הדגמה ─────────────────────────────────────────────────────────── opt
# רשימת ה-slug של דיירי הדמו שמותר להיכנס אליהם בלחיצה, מופרדת בפסיק.
# הסרת המשתנה מכבה את כניסת הדמו לחלוטין. גם כשהוא מוגדר, המסד מסרב
# לכל דייר שאינו מסומן is_demo — שני מנעולים בלתי תלויים.
DEMO_TENANT_SLUGS="demo-lavi,demo-tavor,demo-masika"              # [opt] ריק = כבוי

# ── מתגי פיתוח ──────────────────────────────────────────────────────────── opt
BOSSI_DEFAULT_PLAN="starter"                          # [opt] starter | pro | mega
