{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @bossi/web build",
  "outputDirectory": "apps/web/.next",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/daily-scan", "schedule": "0 4 * * *" },
    { "path": "/api/cron/dunning", "schedule": "0 6 * * *" },
    { "path": "/api/cron/morning-digest", "schedule": "0 4 * * *" }
  ]
}
