{
  "name": "bossi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "modules": "tsx scripts/modules.ts",
    "check": "pnpm typecheck && pnpm test && pnpm modules services >/dev/null"
  },
  "dependencies": {
    "@bossi/kernel": "workspace:*",
    "@bossi/modules": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
